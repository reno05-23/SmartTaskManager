<template>
    <div class="page" data-name="tugas">
        <div class="about-header warna_dasar_sistem text-color-white padding">
            <h1>Daftar Tugas</h1>
            <p>Tugas Tersimpan</p>
        </div>

        <div class="page-content">
            <div class="block" style="padding-top:12px;">
                <div class="segmented segmented-raised">
                    <a class="button active" data-filter="all">Semua</a>
                    <a class="button" data-filter="belum">Belum Selesai</a>
                    <a class="button" data-filter="selesai">Selesai</a>
                </div>
            </div>

            <div class="block" style="position:relative;">
                <div class="card margin-horizontal tugas-card">
                    <div class="card-header tugas-card-header">
                        <div class="header-row">
                            <div class="title-uraian">Uraian</div>
                            <div class="title-deadline">Deadline</div>
                        </div>
                    </div>
                    <div class="card-content card-content-padding"
                        style="min-height:350px;">
                        <div
                            class="list list-outline-ios list-strong-ios list-dividers-ios no-chevron">
                            <ul id="taskmanager_blok">
                            </ul>
                        </div>
                    </div>
                </div>
                <a href="/tambah_tugas/" class="fab fab-raised fab-blue senter-fab"
                    aria-label="Tambah tugas" title="Tambah tugas">

                    <i class="icon f7-icons">plus</i>
                </a>
            </div>
        </div>
    </div>
</template>
<script>
export default (props, { $, $on }) => {

    let filterAktif = 'all';

    const hitungSelisih = (tgl_deadline) => {
        let hari_ini = new Date();
        hari_ini.setHours(0, 0, 0, 0);
        let deadline = new Date(tgl_deadline);
        deadline.setHours(0, 0, 0, 0);
        let selisih = Math.round((deadline - hari_ini) / (1000 * 60 * 60 * 24));
        if (selisih < 0) return `<span style="color:#e74c3c;font-weight:600;">Terlambat<br>${Math.abs(selisih)} hari</span>`;
        if (selisih === 0) return `<span style="color:#e67e22;font-weight:600;">Hari ini!</span>`;
        return `<span style="color:#27ae60;font-weight:600;">Kurang<br>${selisih} hari lagi</span>`;
    };

    const tampilTugas = (filter) => {
        let blok = document.getElementById("taskmanager_blok");
        if (!blok) return;
        blok.innerHTML = "";

        let baca = db.transaction(["tabel_tugas"], "readonly")
            .objectStore("tabel_tugas")
            .index("tgl_deadline")
            .openCursor(null, "prev");

        baca.onsuccess = function(event) {
            let item = event.target.result;
            if (item) {
                let data = item.value;
                if (filter === 'all' || data.status_selesai === filter) {
                    let dtx = `<li>
                        <a href="/update_tugas/${data.id}/" class="item-link item-content" style="display:block;padding:10px 16px;border-bottom:1px solid #f0f0f0;text-decoration:none;">
                            <div style="display:flex;align-items:center;gap:8px;">
                                <div style="flex:1 1 auto;min-width:0;">
                                    <div style="font-weight:600;font-size:15px;color:#333;">${data.judul_tugas}</div>
                                    <div style="font-size:12px;color:#888;margin-top:2px;">${data.kategori}</div>
                                    <div style="font-size:12px;color:#888;margin-top:1px;">Status: ${data.status_selesai}</div>
                                    <div style="font-size:12px;color:#555;margin-top:4px;">${data.catatan ? data.catatan : ''}</div>
                                </div>
                                <div style="flex:0 0 90px;text-align:center;border-left:1px solid #eee;padding-left:10px;">
                                    <div style="font-size:11px;color:#aaa;margin-bottom:4px;">${data.tgl_deadline}</div>
                                    <div style="font-size:12px;line-height:1.4;">${hitungSelisih(data.tgl_deadline)}</div>
                                </div>
                            </div>
                        </a>
                    </li>`;
                    blok.insertAdjacentHTML('beforeend', dtx);
                }
                item.continue();
            } else {
                if (blok.innerHTML === '') {
                    blok.innerHTML = `<li><div style="padding:20px;text-align:center;color:#aaa;font-size:13px;">Tidak ada tugas</div></li>`;
                }
            }
        };

        baca.onerror = function(event) {
            app.dialog.alert(`Tugas Gagal Dibaca. Error: ${event.target.errorCode}`, "Error");
        };
    };

    // Expose ke window supaya bisa dipanggil dari home.f7
    window._tampilTugas = tampilTugas;

    $on('pageInit', () => {
        filterAktif = 'all';
        setTimeout(() => { tampilTugas('all'); }, 200);

        $(document).off('click', '.page[data-name="tugas"] .segmented .button');
        $(document).on('click', '.page[data-name="tugas"] .segmented .button', function() {
            $('.page[data-name="tugas"] .segmented .button').removeClass('active');
            $(this).addClass('active');
            filterAktif = $(this).attr('data-filter');
            tampilTugas(filterAktif);
        });
    });

    $on('pageBeforeRemove', () => {
        $(document).off('click', '.page[data-name="tugas"] .segmented .button');
        window._tampilTugas = null;
    });

    return $render;
}

</script>