<template>
    <div class="page" data-name="beranda">

        <!-- Header -->
        <div class="about-header warna_dasar_sistem text-color-white padding">
            <h1>Smart Task Manager</h1>
            <p>Selamat Datang</p>
        </div>
        <!-- Senter button (moved from tabbar) - styled like FAB -->
        <a href="javascript:void(0)" id="btn-senter"
            class="fab fab-raised fab-blue senter-fab" aria-label="Senter"
            title="Senter">
            <i class="icon f7-icons">light_max</i>
            <span class="tabbar-label" style="display:none">Senter</span>
        </a>

        <div class="page-content">
            <!-- Ringkasan -->
            <div class="card margin-top card-ringkasan">
                <div class="card-content card-content-padding">
                    <div class="font16">
                        <b>Tugas belum selesai</b>
                    </div>
                    <div id="beranda-angka-belum" class="jumlah-tugas"> 0</div>
                    <div id="beranda-total" class="font16 color-white">Dari 0
                        tugas total</div>
                </div>
            </div>

            <!-- Statistik -->
            <div class="row grid grid-cols-3 margin-horizontal">
                <div class="col">
                    <div class="card card-statistik">
                        <div class="card-content card-content-padding">
                            <div id="angka-selesai" class="jumlah-tugas angka-selesai">0</div>
                            <div class="font14"> Selesai</div>
                        </div>
                    </div>
                    <!-- mini senter moved to footer area -->
                </div>

                <div class="col">
                    <div class="card card-statistik">
                        <div class="card-content card-content-padding">
                            <div id="angka-deadline" class="jumlah-tugas angka-deadline">0</div>
                            <div class="font14"> Mendekati Deadline</div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card card-statistik">
                        <div class="card-content card-content-padding">
                            <div id="angka-terlambat" class="jumlah-tugas angka-terlambat">0</div>
                            <div class="font14"> Terlambat </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Divider under 3-col cards -->
            <div class="hr-divider"></div>

            <!-- Sinkronisasi card (aligned with other cards) -->
            <div class="beranda-sinkron-content margin-horizontal">
                <a href="#" id="btnsinkron" class="link sheet-open"
                    data-sheet="#sheet-backup">
                    <div class="card margin-top beranda-sinkron-card">
                        <div
                            class="card-content card-content-padding beranda-sinkron-content">
                            <div class="beranda-sinkron-icon">
                                <img src="img/iconbak.png" />
                            </div>
                            <div class="beranda-sinkron-body">
                                <div class="beranda-sinkron-title">Backup Data</div>
                            </div>
                            <div class="beranda-sinkron-arrow"></div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="hr-divider"></div>

            <!-- Tugas Terbaru header -->
            <div class="section-header">
                <div style="font-weight:700;color:#333;">Tugas Terbaru</div>
                <a href="/tugas/" class="link">Lihat Selengkapnya >></a>
            </div>

            <!-- Latest tasks list -->
            <div class="card margin-horizontal card-list-latest">
                <div class="list no-margin-top">
                    <ul id="beranda-tugas-list"
                        style="margin:0;padding:0;list-style:none;">
                        <!-- items will be injected here -->
                    </ul>
                </div>
            </div>
        </div>



        <!-- Sheet Modal Form Backup Online -->
        <div class="sheet-modal" id="sheet-backup" style="height: auto;"
            data-swipe-to-close="true" data-backdrop="true">
            <div class="sheet-modal-inner">
                <!-- Handle elegan untuk swipe-to-close -->
                <div class="sheet-handler"></div>
                <div class="page-content">
                    <div class="block-title block-title-large">Backup
                        Online</div>
                    <div
                        class="list no-margin-top list-strong-ios list-dividers-ios">
                        <ul>
                            <li
                                class="item-content item-input item-input-outline">
                                <div class="item-inner">
                                    <div
                                        class="item-title item-label">Nama/Deskripsi
                                        Backup</div>
                                    <div class="item-input-wrap">
                                        <input type="text" id="txtnamabackup"
                                            placeholder="Contoh: Backup Awal Bulan" />
                                    </div>

                                </div>
                            </li>
                            <li
                                class="item-content item-input item-input-outline">
                                <div class="item-inner">
                                    <div class="item-title item-label">Channel
                                        Backup</div>
                                    <div class="item-input-wrap">
                                        <select id="cbochannelbackup">
                                            <option value>Pilih Channel</option>
                                            <option
                                                value="laravel">Laravel</option>
                                            <option
                                                value="nodejs">Node.js</option>
                                        </select>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <div class="block">
                        <div class="row grid grid-cols-2 grid-gap">
                            <button type="button" id="backup_btnsimpan"
                                class="button button-fill color-blue">Backup</button>
                            <button type="button"
                                class="button button-fill color-red text-color-white">Reset</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</template>

<script>
import {
    konfigurasidb,
    bacatugas
} from "../js/function.js";
export default (props, { $, $on }) => {
    console.log("SCRIPT BERANDA DIMUAT");
    konfigurasidb();
    // baca data
    setTimeout(function () {
        bacatugas(function (hasil) {
            var total = hasil.length;
            var belum = 0;
            var selesai = 0;
            var deadline = 0;
            var terlambat = 0;
            var hariIni = new Date();

            for (var i = 0; i < hasil.length; i++) {
                if (hasil[i].status_selesai == "belum") {
                    belum++;
                } else {
                    selesai++;
                }
                var tgl = new Date(hasil[i].tgl_deadline);
                var selisih = (tgl - hariIni) / (1000 * 60 * 60 * 24);
                if (selisih >= 0 && selisih <= 3) {
                    deadline++;
                }
                if (selisih < 0 && hasil[i].status_selesai == "belum") {
                    terlambat++;
                }
            }
            // Ringkasan
            document.getElementById("beranda-angka-belum").innerHTML = belum;
            document.getElementById("beranda-total").innerHTML =
                "Dari " + total + " tugas total";
            // Statistik
            document.getElementById("angka-selesai").innerHTML = selesai;
            document.getElementById("angka-deadline").innerHTML = deadline;
            document.getElementById("angka-terlambat").innerHTML = terlambat;
            console.log(hasil);

            // iki nampilno tugas terbaru ng beranda
            var tampil = "";
            // data terbaru ada di akhir array
            for (var i = hasil.length - 1; i >= 0 && i >= hasil.length - 3; i--) {
                tampil += `
                    <li>
                        <a href="/update_tugas/${hasil[i].id}/"
                        class="item-link item-content">
                            <div class="item-inner">
                                <div class="item-title">
                                    <b>${hasil[i].judul_tugas}</b>
                                    <div style="font-size:12px;color:#777;">
                                        ${hasil[i].kategori}
                                    </div>
                                </div>
                                <div class="item-after">
                                    ${hasil[i].tgl_deadline}
                                </div>
                            </div>
                        </a>
                    </li>
                `;
            }
            document.getElementById("beranda-tugas-list").innerHTML = tampil;
        });
    }, 300);
    return $render;
}
</script>