<template>
    <div class="page" data-name="beranda">

        <!-- Header -->
        <div class="about-header warna_dasar_sistem text-color-white padding">
            <h1>Smart Task Manager</h1>
            <p>Selamat Datang</p>
        </div>

        <!-- Senter button (moved from tabbar) - styled like FAB -->
        <a href="javascript:void(0)" id="btn-senter"
            class="fab fab-raised fab-blue senter-fab" aria-label="Senter"
            title="Senter" @click="${senter}">
            <i class="icon f7-icons">light_max</i>
            <span class="tabbar-label" style="display:none">Senter</span>
        </a>

        <div class="page-content">
            <!-- Ringkasan -->
            <div class="card margin-top card-ringkasan">
                <div class="card-content card-content-padding">
                    <div class="font16">
                        <b>Tugas belum selesai</b>
                    </div>
                    <div id="beranda-angka-belum" class="jumlah-tugas"> 0</div>
                    <div id="beranda-total" class="font16 color-white">Dari 0
                        tugas total</div>
                </div>
            </div>

            <!-- Statistik -->
            <div class="row grid grid-cols-3 margin-horizontal">
                <div class="col">
                    <div class="card card-statistik">
                        <div class="card-content card-content-padding">
                            <div id="angka-selesai" class="jumlah-tugas angka-selesai">0</div>
                            <div class="font14"> Selesai</div>
                        </div>
                    </div>
                    <!-- mini senter moved to footer area -->
                </div>

                <div class="col">
                    <div class="card card-statistik">
                        <div class="card-content card-content-padding">
                            <div id="angka-deadline" class="jumlah-tugas angka-deadline">0</div>
                            <div class="font14"> Mendekati Deadline</div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card card-statistik">
                        <div class="card-content card-content-padding">
                            <div id="angka-terlambat" class="jumlah-tugas angka-terlambat">0</div>
                            <div class="font14"> Terlambat </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Divider under 3-col cards -->
            <div class="hr-divider"></div>

            <!-- Sinkronisasi card (aligned with other cards) -->
            <div class="margin-horizontal" style="margin-top:8px;">
                <a href="#" id="btnsinkron" class="link sheet-open"
                    data-sheet="#sheet-backup" style="display:block;width:100%;">
                    <div class="card beranda-sinkron-card" style="margin:0;">
                        <div
                            class="card-content card-content-padding beranda-sinkron-content">
                            <div class="beranda-sinkron-icon">
                                <img src="img/iconbak.png" />
                            </div>
                            <div class="beranda-sinkron-body">
                                <div class="beranda-sinkron-title">Backup Data</div>
                            </div>
                            <div class="beranda-sinkron-arrow"></div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="hr-divider"></div>

            <!-- Tugas Terbaru header -->
            <div class="section-header">
                <div style="font-weight:700;color:#333;">Tugas Terbaru</div>
                <a href="/tugas/" class="link">Lihat Selengkapnya >></a>
            </div>

            <!-- Latest tasks list -->
            <div class="card margin-horizontal card-list-latest">
                <div class="list no-margin-top">
                    <ul id="beranda-tugas-list"
                        style="margin:0;padding:0;list-style:none;">
                        <!-- items will be injected here -->
                    </ul>
                </div>
            </div>
        </div>



        <!-- Sheet Modal Form Backup Online -->
        <div class="sheet-modal" id="sheet-backup" style="height: auto;"
            data-swipe-to-close="true" data-backdrop="true">
            <div class="sheet-modal-inner">
                <!-- Handle elegan untuk swipe-to-close -->
                <div class="sheet-handler"></div>
                <div class="page-content">
                    <div class="block-title block-title-large">Backup
                        Online</div>
                    <div
                        class="list no-margin-top list-strong-ios list-dividers-ios">
                        <ul>
                            <li
                                class="item-content item-input item-input-outline">
                                <div class="item-inner">
                                    <div
                                        class="item-title item-label">Nama/Deskripsi
                                        Backup</div>
                                    <div class="item-input-wrap">
                                        <input type="text" id="txtnamabackup"
                                            placeholder="Contoh: Backup Awal Bulan" />
                                    </div>

                                </div>
                            </li>
                            <li
                                class="item-content item-input item-input-outline">
                                <div class="item-inner">
                                    <div class="item-title item-label">Channel
                                        Backup</div>
                                    <div class="item-input-wrap">
                                        <select id="cbochannelbackup">
                                            <option
                                                value="laravel">Laravel</option>
                                            <option
                                                value="nodejs">Node.js</option>
                                        </select>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <div class="block">
                        <div class="row grid grid-cols-2 grid-gap">
                            <button type="button" id="backup_btnsimpan"
                                class="button button-fill color-blue" 
                                @click="${backup_task}">Backup</button>
                            <button type="button" id="backup_btnreset"
                                class="button button-fill color-red text-color-white"
                                @click="${resetFormBackup}">Reset</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</template>

<script>
import { konfigurasidb, senter, getDataFull } from "../js/function.js";
export default (props, { $, $on, $f7 }) => {
    konfigurasidb();

    // fungsi backup online
    const backup_task = async () =>{
        let nama = $("#txtnamabackup").val();
        let channel = $("#cbochannelbackup").val();

        if (nama == ""){
            $f7.dialog.alert("Isian Nama Backup Tidak Tersedia", "Error");
            return;
        }

        if (channel == ""){
            $f7.dialog.alert("Pilih Channel Backup", "Error");
            return;
        }

        $f7.dialog.progress("Proses Backup ....");
        let dttugas = await getDataFull("tabel_tugas");
        if (dttugas.length > 0){
            let dtx = "";
            for (let x of dttugas){
                let id = x.id;
                let judul = x.judul_tugas;
                let deadline = x.tgl_deadline;
                let kategori = x.kategori;
                let status = x.status_selesai;
                let catatan = x.catatan || "";
                dtx += `${id}|${judul}|${deadline}|${kategori}|${status}|${catatan}#`;
            }

            let url = channel == "laravel"
                ? "https://taskmanagerapilav.renoaries.my.id/api/backup"
                : "https://taskmanagerapinode.renoaries.my.id/backup";

            fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    nama_backup: nama,
                    dtx: btoa(dtx.slice(0, -1))
                })
            })
            .then(response => {
                if (!response.ok){
                    $f7.dialog.close();
                    $f7.dialog.alert(`HTTP error! status: ${response.status}`, "Error");
                    return;
                }
                return response.json();
            })
            .then(data => {
                $f7.dialog.close();
                if (data && data.kode == "01"){
                    $f7.dialog.alert(
                        `${data.status}\nBerhasil: ${data.berhasil}, Gagal: ${data.gagal}`,
                        "Berhasil");
                    $("#txtnamabackup").val("");
                    $("#cbochannelbackup").val("laravel").change();
                    $f7.sheet.close("#sheet-backup");
                } else if (data){
                    $f7.dialog.alert(data.status, "Error");
                }
            })
            .catch(error =>{
                $f7.dialog.close();
                console.error("Backup error:", error);
                $f7.dialog.alert("Terjadi kesalahan pada server", "Error");
            });
        }else{
            $f7.dialog.close();
            $f7.dialog.alert("Data Tugas Yang Akan di Backup Tidak Tersedia", "Info");
            return;
        }
    };

    // tombol reset di backup
    const resetFormBackup = () =>{
        $("#txtnamabackup").val("");
        $("#cbochannelbackup").val("").change();
    };

    return $render;
}
</script>


