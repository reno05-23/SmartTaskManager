<script>
export default (props, { $, $on }) => {
    if (typeof window !== 'undefined') {
        // ini adalah script untuk menangani tombol open-backup pada sheet sinkronisasi, agar bisa membuka sheet backup dengan benar
        document.addEventListener('click', function (e) {
            var el = e.target.closest && e.target.closest('.open-backup');
            if (!el) return;
            e.preventDefault();
            try {
                if (window.app && app.sheet) {
                    app.sheet.open('#sheet-backup');
                } else {
                    var sb = document.getElementById('sheet-backup');
                    if (sb && sb.style) sb.style.display = 'block';
                }
            } catch (err) {
                console.error('open-backup error', err);
            }
        });
    }
    return $render;
}
</script>
