<template>
    <div class="page" data-name="update_tugas">
        <!-- HEADER -->
        <div class="custom-header warna_dasar_sistem">
            <div class="header-top">
                <div>
                    <h1>Update Tugas</h1>
                    <p>Ubah detail tugas atau hapus tugas</p>
                </div>
                <a href="/tugas/" class="link icon-only close-page">
                    <i class="icon f7-icons text-color-white">xmark</i>
                </a>
            </div>
        </div>

        <!-- CONTENT -->
        <div class="page-content">
            <div class="form-wrapper">
                <div class="form-card">
                    <input type="hidden" id="id_tugas" />
                    <div class="form-group">
                        <label>Judul Tugas</label>
                        <input type="text" id="judul" placeholder="Tulis judul..." />
                    </div>
                    <div class="form-group">
                        <label>Mata Kuliah</label>
                        <input type="text" id="mata_kuliah" placeholder="Pilih matkul..." />
                    </div>
                    <div class="form-group">
                        <label>Deadline</label>
                        <input type="date" id="deadline" />
                    </div>
                    <div class="form-group">
                        <label>Status</label>
                        <select id="status">
                            <option value="belum">Belum selesai</option>
                            <option value="selesai">Selesai</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Catatan (opsional)</label>
                        <textarea id="catatan" rows="4" placeholder="Tambahkan catatan..."></textarea>
                    </div>
                    <div class="block" style="display:flex;gap:8px">
                        <button type="button" id="transaksi_btnupdate"
                            class="button button-fill warna_dasar_sistem color-white"
                            @click="${update_tugas}">Update
                        </button>
                        <button type="button" id="transaksi_btnhapus"
                            class="button button-outline color-red"
                            @click="${hapus_tugas}">Hapus
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</template>
<script>
export default (props, { $, $on }) => {
    let id = Number(props.id);

    $on('pageInit', () => {
        let baca = db.transaction(["tabel_tugas"], "readonly")
                     .objectStore("tabel_tugas")
                     .get(id);

        baca.onsuccess = function(event) {
            let data = event.target.result;
            if(data) {
                $("#id_tugas").val(data.id);
                $("#judul").val(data.judul_tugas);
                $("#mata_kuliah").val(data.kategori);
                $("#deadline").val(data.tgl_deadline);
                $("#status").val(data.status_selesai);
                $("#catatan").val(data.catatan);
            }
        };

        baca.onerror = function(event) {
            app.dialog.alert(`Data Gagal Dimuat. Error: ${event.target.errorCode}`, "Error");
        };
    });

    const update_tugas = () => {
        let id       = $("#id_tugas").val();
        let judul    = $("#judul").val();
        let kategori = $("#mata_kuliah").val();
        let deadline = $("#deadline").val();
        let status   = $("#status").val();
        let catatan  = $("#catatan").val();

        if(id == "" || judul == "" || kategori == "" || deadline == "" || status == ""){
            app.dialog.alert("Ada Isian yang Masih Kosong", "Error");
            return;
        }

        let data = {id: Number(id), judul_tugas: judul, tgl_deadline: deadline, kategori: kategori, status_selesai: status, catatan: catatan};
        let proses = db.transaction(["tabel_tugas"], "readwrite").objectStore("tabel_tugas").put(data);

        proses.onsuccess = function(event) {
            app.dialog.alert("Update Tugas Berhasil", "Sukses");
            app.views.main.router.back();
        };

        proses.onerror = function(event) {
            app.dialog.alert(`Update Tugas Gagal. Error: ${event.target.errorCode}`, "Error");
        };
    };

    const hapus_tugas = () => {
        let id = $("#id_tugas").val();

        if(id == ""){
            app.dialog.alert("Ada Isian yang Masih Kosong", "Error");
            return;
        }

        app.dialog.confirm("Anda Yakin Ingin Menghapus Data Ini?", "Konfirmasi",
            function() {
                let proses = db.transaction(["tabel_tugas"], "readwrite")
                               .objectStore("tabel_tugas")
                               .delete(Number(id));

                proses.onsuccess = function(event) {
                    app.dialog.alert("Hapus Tugas Berhasil", "Sukses");
                    app.views.main.router.back();
                };

                proses.onerror = function(event) {
                    app.dialog.alert(`Hapus Tugas Gagal. Error: ${event.target.errorCode}`, "Error");
                };
            }
        );
    };

    return $render;
}
</script>