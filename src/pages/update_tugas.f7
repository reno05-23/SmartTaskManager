<template>
    <div class="page" data-name="update_tugas">
        <!-- HEADER -->
        <div class="custom-header warna_dasar_sistem">
            <div class="header-top">
                <div>
                    <h1>Update Tugas</h1>
                    <p>Ubah detail tugas atau hapus tugas</p>
                </div>
                <a href="#" class="link icon-only close-page">
                    <i class="icon f7-icons text-color-white">xmark</i>
                </a>
            </div>
        </div>

        <!-- CONTENT -->
        <div class="page-content">
            <div class="form-wrapper">
                <div class="form-card">
                    <form id="form-update-tugas">
                        <input type="hidden" id="id_tugas" />
                        <div class="form-group">
                            <label>Mata Kuliah</label>
                            <input type="text"
                                id="judul"
                                placeholder="tulis judul..." />
                        </div>
                        <div class="form-group">
                            <label>Mata Kuliah</label>
                            <input type="text"
                                id="mata_kuliah"
                                placeholder="Pilih matkul..." />
                        </div>
                        <div class="form-group">
                            <label>Deadline</label>
                            <input type="date" id="deadline" />
                        </div>
                        <div class="form-group">
                            <label>Status</label>
                            <select id="status">
                                <option value="belum">
                                    Belum selesai
                                </option>
                                <option value="selesai">
                                    Selesai
                                </option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Catatan (opsional)</label>
                            <textarea id="catatan"
                                rows="4"
                                placeholder="Tambahkan catatan..."></textarea>
                        </div>
                        <div class="block" style="display:flex;gap:8px">
                            <button type="submit"
                                class="button button-fill warna_dasar_sistem color-white">Update</button>
                            <button type="button" id="btn-hapus"
                                class="button button-outline color-red">Hapus</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</template>
<script> 
import { ambilsatutugas, updatetugas, hapustugas } from "../js/function.js"; 
export default (props, { $, $on }) => {
    var id = Number(props.id);
    $on('pageInit', function () {
        // nk diklik salah satu-> melbu update->form
        ambilsatutugas(id, function (data) {
            document.getElementById("id_tugas").value = data.id;
            document.getElementById("judul").value =
                data.judul_tugas;
            document.getElementById("mata_kuliah").value =
                data.kategori;
            document.getElementById("deadline").value =
                data.tgl_deadline;
            document.getElementById("status").value =
                data.status_selesai;
            document.getElementById("catatan").value =
                data.catatan;
            console.log(data);
        });
    });
    // iki ngupdate
    document.addEventListener("submit", function (e) {
        if (e.target.id != "form-update-tugas") return;
        e.preventDefault();
        var id = Number(document.getElementById("id_tugas").value);
        var judul = document.getElementById("judul").value;
        var kategori = document.getElementById("mata_kuliah").value;
        var deadline = document.getElementById("deadline").value;
        var status = document.getElementById("status").value;
        var catatan = document.getElementById("catatan").value;
        updatetugas(
            id,
            judul,
            deadline,
            kategori,
            status,
            catatan
        );
        console.log("UPDATE BERHASIL");
    });
    // iki hapus
    document.addEventListener("click", function (e) {
        if (e.target.id != "btn-hapus") return;
        var id = Number(document.getElementById("id_tugas").value);
        hapustugas(id);
        console.log("DATA DIHAPUS");
    });
    return $render;
}
</script>